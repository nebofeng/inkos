{
  "name": "test-project",
  "version": "0.1.0",
  "notify": [],
  "daemon": {
    "schedule": {
      "radarCron": "0 */6 * * *",
      "writeCron": "*/15 * * * *"
    },
    "maxConcurrentBooks": 3
  },
  "language": "zh",
  "context": {
    "profile": "default",
    "windowCapTokens": 128000,
    "autoConsolidateOnGuard": true,
    "maxGuardRetries": 2,
    "predictiveThreshold": 0.85
  },
  "deslop": {
    "enabled": true,
    "keepOriginal": true,
    "maxRetries": 2
  },
  "detection": {
    "enabled": true,
    "provider": "custom",
    "apiUrl": "https://detector.example.com/api",
    "apiKeyEnv": "DETECT_API_KEY",
    "threshold": 0.5,
    "autoRewrite": true,
    "maxRetries": 3
  }
}
