# 复制成 /opt/docker-dir/inkos/.env 后再填值；chmod 600 .env。这个文件只写变量名，不写任何真实值。
# compose 用它做变量替换，同时整份作为容器环境变量（env_file）。

# ---- 镜像与端口 ----
INKOS_IMAGE=inkos:1.8.0-34b3213b
# Studio 在宿主机上的绑定地址和端口：服务器1 只绑 Docker 内网 docker0 网关，NPM 从 172.17.0.1:4567 转发。不要绑 0.0.0.0
INKOS_BIND=172.17.0.1
INKOS_PORT=4567
# sub2api 所在的 docker 网络名。服务器1 = sub2api_sub2api-network（sub2api 别名 sub2api、容器端口 8080）
# inkos.json 里 baseUrl 用 http://sub2api:8080/v1
SUB2API_NETWORK=sub2api_sub2api-network
TZ=Asia/Shanghai

# ---- 运行用户（要和 ./data 的属主一致；服务器3 数据属主是 1000:1000）----
INKOS_UID=1000
INKOS_GID=1000

# ---- 重启策略：异常退出最多自动重启 5 次（配置错误不会无限重启）。想无限重启可改 unless-stopped ----
INKOS_RESTART=on-failure:5

# ---- 内存上限（Studio、daemon 各一个容器）----
INKOS_MEM_LIMIT=1g
INKOS_DAEMON_MEM_LIMIT=1g

# ---- 日志轮转（docker json-file）----
INKOS_LOG_MAX_SIZE=20m
INKOS_LOG_MAX_FILE=5

# ---- 大模型 key ----
# 推荐（已定）：0 = 继续用 data/.inkos/secrets.json 里的 key（从服务器3 迁过来），.env 不覆盖它，也不需要下面的 key 变量。
INKOS_SECRETS_FROM_ENV=0
# 只有改成 1 时才需要：启动时把 <服务ID>_API_KEY 写进 data/.inkos/secrets.json
# （inkos.json 里 {"service":"custom","name":"sub2api"} 对应 CUSTOM_SUB2API_API_KEY）
# CUSTOM_SUB2API_API_KEY=

# ---- 可选（不需要就保持注释）----
# 跳过 daemon 启动前的模型配置检查（不建议）
# INKOS_SKIP_LLM_CHECK=1
# 网页搜索
# TAVILY_API_KEY=
# 知识图谱检索开关（默认关；见 README）
# INKOS_STORY_GRAPH=0
# 注意：不要随便设置 INKOS_LLM_BASE_URL / INKOS_LLM_API_KEY / INKOS_LLM_MODEL，
# 它们会覆盖 inkos.json 里 Studio 选好的服务，可能让 daemon 换到别的服务/模型。
